---
import '../styles/global.css';
import { site, whatsappLink } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = site.socialImage,
  canonicalPath,
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath || Astro.url.pathname, site.domain);
const ogImage = image.startsWith('http') ? image : new URL(image, site.domain).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.domain}/#coach`,
  name: 'Shayaan',
  url: site.domain,
  image: ogImage,
  jobTitle: 'Padel Coach',
  knowsAbout: ['Padel', 'Padel coaching', 'Padel technique', 'Padel tactics'],
  areaServed: { '@type': 'City', name: 'Nairobi' },
  worksFor: {
    '@type': 'SportsActivityLocation',
    name: 'Ace Padel',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Nairobi',
      addressCountry: 'Kenya',
    },
  },
};

const allSchemas = [personSchema];
if (jsonLd) {
  if (Array.isArray(jsonLd)) allSchemas.push(...jsonLd);
  else allSchemas.push(jsonLd);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.coachName} />
    <meta name="theme-color" content="#101813" />
    <meta name="format-detection" content="telephone=no" />
    <meta
      name="robots"
      content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta property="og:locale" content="en_KE" />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.tagline}`} />

    <link rel="preconnect" href="https://images.pexels.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RZ3JBHGDNB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-RZ3JBHGDNB');
    </script>
  </head>
  <body><slot /></body>
</html>

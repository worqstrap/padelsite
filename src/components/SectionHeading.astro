---
interface Props { eyebrow: string; title: string; text?: string; light?: boolean }
const { eyebrow, title, text, light = false } = Astro.props;
---
<div class="section-head"><div><p class:list={['eyebrow', light && 'eyebrow--light']}>{eyebrow}</p><h2>{title}</h2></div>{text && <p class="lead">{text}</p>}</div>

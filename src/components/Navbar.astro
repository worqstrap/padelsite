---
import { site, nav, whatsappLink } from '../data/site';
import WhatsAppButton from './WhatsAppButton.astro';
---

<header class="site-header" id="site-header">
  <a href="/" class="brand" aria-label="Shayaan Padel home">
    <span class="brand-mark" aria-hidden="true">S</span>
    <span>Shayaan<span class="brand-light">/Padel</span></span>
  </a>
  <nav class="nav-desktop" aria-label="Main navigation">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="header-actions">
    <a class="btn btn-dark btn-sm header-cta" href={whatsappLink('Hi Shayaan, I\'d like to book a padel coaching session.')} target="_blank" rel="noopener noreferrer" data-track="book-coaching">
      Book Coaching
    </a>
    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" id="nav-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
  <nav aria-label="Mobile navigation">
    {nav.map((item) => <a href={item.href} class="mobile-nav-link">{item.label}</a>)}
    <a href={whatsappLink('Hi Shayaan, I\'d like to book a padel coaching session.')} target="_blank" rel="noopener noreferrer" class="btn btn-lime mobile-nav-cta" data-track="book-coaching">
      Book Coaching
    </a>
  </nav>
</div>

---
import Layout from '../layouts/Layout.astro'; import Button from '../components/Button.astro'; import FAQ from '../components/FAQ.astro'; import {site} from '../data/site';
const faq=[{question:'Does Shayaan coach at Ace Padel?',answer:'Yes. Ace Padel at Aga Khan Sports Centre is Shayaan’s exclusive coaching location in Nairobi.'},{question:'Does Shayaan own Ace Padel?',answer:'No. Ace Padel is Shayaan’s coaching partner and location; it is not presented as a business owned by Shayaan.'},{question:'How can I confirm court facilities or availability?',answer:'Use the Ace Padel Instagram link or Playtomic. Details such as opening hours and court count are intentionally not published here until verified.'}];
---
<Layout title="Ace Padel Nairobi | Coaching at Aga Khan Sports Centre" description="Discover Ace Padel at Aga Khan Sports Centre, Shayaan's exclusive padel coaching location in Nairobi, Kenya."><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Ace Padel</div><p class="eyebrow eyebrow--light">Official coaching location</p><h1>Train with Shayaan at Ace Padel.</h1><p class="lead">Ace Padel · Aga Khan Sports Centre · Nairobi, Kenya</p><div class="button-row"><Button href={site.bookingUrl} variant="lime" external event="book_coaching_click">Book Coaching</Button><Button href={site.instagramUrl} variant="outline" external event="instagram_click">Visit Ace Instagram</Button></div></div></section><section class="section"><div class="container venue-feature"><div class="venue-media" role="img" aria-label="Placeholder for verified Ace Padel venue photography"></div><div class="venue-copy"><span class="location-chip">Ace Padel partner venue</span><h2>My coaching home in Nairobi.</h2><p>I coach exclusively at Ace Padel at Aga Khan Sports Centre. The partnership gives every coaching journey a clear, consistent home.</p><p>This site does not claim ownership of Ace Padel. Venue details that have not been supplied—such as court count, surface, opening hours and exact booking deep link—remain unpublished until verified.</p><div class="button-row"><Button href="/coaching" variant="lime">Explore Coaching</Button><Button href={site.playtomicUrl} variant="outline" external event="playtomic_click">Open Playtomic</Button></div></div></div></section><section class="section section--sand"><div class="container resource-banner"><div><p class="eyebrow">Location</p><h2>Aga Khan Sports Centre, Nairobi.</h2><p class="lead">A map and verified directions link can be added here as soon as the official listing is supplied.</p><div class="notice">Map placeholder — no unverified street address or pin has been published.</div></div><div class="card"><h3>Looking for coaching?</h3><p>Train with Shayaan here at Ace Padel. Looking only for a court? Open Playtomic to check current availability.</p></div></div></section><section class="section"><div class="container"><h2>Frequently asked questions</h2><FAQ items={faq}/></div></section></Layout>

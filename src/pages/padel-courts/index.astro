import Layout from '../../layouts/Layout.astro'; import VenueCard from '../../components/VenueCard.astro'; import Button from '../../components/Button.astro'; import {padelCourts,plannedLocations} from '../../data/padelCourts';
---
<Layout title="Padel Courts in Kenya | Nairobi & Beyond" description="Find verified padel clubs and courts in Nairobi and across Kenya. Browse independent venue information and discover where to play padel."><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Padel Courts</div><p class="eyebrow eyebrow--light">Independent directory</p><h1>Padel courts in Kenya.</h1><p class="lead">Discover clubs, courts and places to play across Nairobi and Kenya. Directory listings do not mean Shayaan coaches at those venues.</p></div></section><section class="section"><div class="container"><div class="notice"><strong>Coaching is different from court discovery:</strong> Shayaan coaches exclusively at Ace Padel, Aga Khan Sports Centre. Other future listings are informational only.</div><div class="directory-grid">{padelCourts.map(court=><VenueCard court={court}/>)}</div></div></section><section class="section section--sand"><div class="container resource-banner"><div><p class="eyebrow">Directory roadmap</p><h2>More verified Kenya venues are coming.</h2><p class="lead">We will only add facilities, court numbers, booking methods and locations after verifying them with primary club sources.</p></div><div class="card"><h3>Planned location filters</h3><p>{plannedLocations.join(' · ')}</p><p class="meta">Planning labels—not published venue claims</p></div></div></section><section class="accent-cta"><p class="eyebrow">Want to improve your game?</p><h2>Padel coaching is exclusively at Ace Padel.</h2><p>Aga Khan Sports Centre, Nairobi.</p><Button href="/coaching" variant="dark">View Coaching</Button></section></Layout>

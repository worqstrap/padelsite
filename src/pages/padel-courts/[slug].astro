---
import Layout from '../../layouts/Layout.astro'; import Button from '../../components/Button.astro'; import FAQ from '../../components/FAQ.astro'; import {padelCourts} from '../../data/padelCourts'; import {site} from '../../data/site';
export function getStaticPaths(){ return padelCourts.map(court=>({params:{slug:court.slug},props:{court}})); } const {court}=Astro.props;
const faq=[{question:`Where is ${court.name}?`,answer:`The venue is at ${court.area} in ${court.city}, ${court.country}. Use the official club channel for a verified map pin and arrival instructions.`},{question:'Can I book coaching with Shayaan here?',answer:court.coachingVenue?'Yes. This is Shayaan’s exclusive coaching location.':'No. Shayaan coaches exclusively at Ace Padel, Aga Khan Sports Centre.'},{question:'How do I book a court?',answer:'Check the venue’s official channel or Playtomic for current court availability and booking terms.'}];
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://padelsiteshayaan.netlify.app/'},{'@type':'ListItem',position:2,name:'Padel Courts',item:'https://padelsiteshayaan.netlify.app/padel-courts'},{'@type':'ListItem',position:3,name:court.name,item:`https://padelsiteshayaan.netlify.app/padel-courts/${court.slug}`} ]};
---
<Layout title={`${court.name} | Padel Courts in ${court.city}`} description={`${court.name} at ${court.area}, ${court.city}. View verified location and booking information plus coaching at Ace Padel.`}><script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}/><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/padel-courts">Padel Courts</a> / {court.name}</div><p class="eyebrow eyebrow--light">Padel courts in {court.city}</p><h1>{court.name}</h1><p class="lead">{court.area}, {court.city}, {court.country}</p></div></section><section class="section"><div class="container resource-banner"><div class="prose"><h2>Venue overview</h2><p>{court.summary}</p><div class="notice">This page only displays venue details currently verified or supplied by Shayaan. Missing facility and court information is not guessed.</div><h2>Booking and directions</h2><p>Use official club channels or Playtomic for live availability, pricing, cancellations and directions.</p><div class="button-row">{court.instagramUrl&&<Button href={court.instagramUrl} variant="dark" external event="instagram_click">Official Instagram</Button>}<Button href={site.playtomicUrl} variant="outline" external event="playtomic_click">Open Playtomic</Button></div></div><div class="image-slot" style="min-height:550px"><small>Verified venue photography slot</small></div></div></section><section class="section section--sand"><div class="container"><h2>Frequently asked questions</h2><FAQ items={faq}/></div></section><section class="accent-cta"><p class="eyebrow">Want to improve your game?</p><h2>Train with Shayaan at Ace Padel.</h2><p>Padel coaching is available exclusively at Ace Padel, Aga Khan Sports Centre.</p><Button href={site.bookingUrl} variant="dark" external event="book_coaching_click">Book Coaching</Button></section></Layout>

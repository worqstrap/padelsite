---
import Layout from '../../layouts/Layout.astro'; import Button from '../../components/Button.astro';
const categories=[['Beginner Guides','Start with the court, scoring, positioning and the first shots you need.'],['Technique','Build reliable contact, movement and padel-specific shots.'],['Tactics','Learn when to defend, attack and change court position.'],['Playtomic','Understand bookings, games and ratings in the Playtomic ecosystem.'],['Padel Rules','Clear explanations for players learning how padel works.'],['Match Strategy','Improve partnership, shot selection and momentum.'],['Equipment','Choose gear based on your level and needs—not hype.'],['Nairobi Padel','Guides to courts, games and the growing Kenya community.']];
---
<Layout title="Learn Padel | Beginner Guides, Rules & Tactics Kenya" description="Learn how to play padel with beginner guides, rules, technique, tactics, equipment and Nairobi-specific padel resources from Shayaan."><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Learn</div><p class="eyebrow eyebrow--light">Padel knowledge hub</p><h1>Learn padel.</h1><p class="lead">Practical, padel-specific guidance for beginners, developing players and competitors in Nairobi and across Kenya.</p></div></section><section class="section section--sand"><div class="container"><div class="card-grid">{categories.map(([title,text],i)=><article class="card"><span class="number">{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{text}</p><span class="placeholder-label">Guides in development</span></article>)}</div></div></section><section class="section"><div class="container resource-banner"><div><p class="eyebrow">Start here</p><h2>New to padel in Nairobi?</h2><p class="lead">Combine clear learning resources with a beginner coaching session at Ace Padel.</p></div><div class="resource-links"><a href="/coaching/beginner-padel-coaching-nairobi">Beginner Coaching <span>→</span></a><a href="/playtomic-kenya">Playtomic Kenya Guide <span>→</span></a><a href="/padel-courts">Find Padel Courts <span>→</span></a></div></div></section><section class="accent-cta"><p class="eyebrow">Turn knowledge into action</p><h2>Learn it. Train it. Use it in a match.</h2><Button href="/coaching" variant="dark">Explore Coaching</Button></section></Layout>

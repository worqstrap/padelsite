---
import Layout from '../../layouts/Layout.astro'; import Button from '../../components/Button.astro'; import FAQ from '../../components/FAQ.astro'; import { coachingPrograms, site } from '../../data/site';
export function getStaticPaths(){ const beginner={slug:'beginner-padel-coaching-nairobi',title:'Beginner Padel Coaching',audience:'New players in Nairobi.',description:'A welcoming introduction to padel technique, positioning, scoring and safe movement.',focuses:['Racket basics and contact','Court positioning','Rules and match confidence'],cta:'Start Beginner Coaching'}; return [...coachingPrograms,beginner].map(program=>({params:{slug:program.slug},props:{program}})); }
const { program } = Astro.props; const whatsapp=site.whatsappUrl(program.slug.includes('beginner')?"Hi Shayaan, I'm new to padel and would like information about beginner coaching at Ace Padel.":`Hi Shayaan, I found your website and I'm interested in ${program.title.toLowerCase()} at Ace Padel.`);
const faq=[{question:`Where does ${program.title.toLowerCase()} take place?`,answer:'All coaching with Shayaan takes place exclusively at Ace Padel, Aga Khan Sports Centre in Nairobi.'},{question:'How do I book?',answer:'Use the booking button to open Shayaan’s Playtomic profile, or start a WhatsApp message to discuss the right session.'},{question:'Do I need a Playtomic rating?',answer:'No. You can start coaching without a rating. If you already know yours, it can help provide context, but it is not an official coaching classification.'}];
---
<Layout title={`${program.title} Nairobi | Shayaan Padel`} description={`${program.description} Train with Shayaan exclusively at Ace Padel, Aga Khan Sports Centre, Nairobi.`}><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/coaching">Coaching</a> / {program.title}</div><p class="eyebrow eyebrow--light">Padel coaching · Nairobi, Kenya</p><h1>{program.title}</h1><p class="lead">{program.description} Every session is delivered exclusively at Ace Padel, Aga Khan Sports Centre.</p><div class="button-row"><Button href={site.bookingUrl} variant="lime" external event="book_coaching_click">Book This Coaching</Button><Button href={whatsapp} variant="outline" external event="whatsapp_click">WhatsApp Shayaan</Button></div></div></section><section class="section"><div class="container resource-banner"><div class="prose"><p class="eyebrow">What we work on</p><h2>A clearer, more confident game.</h2><p>{program.audience} We connect technical work to real decisions: where you stand, how you move with your partner and which ball gives your team the best next position.</p><ul>{program.focuses.map((f)=><li>{f}</li>)}</ul><div class="notice"><strong>Official coaching location:</strong> Ace Padel, Aga Khan Sports Centre, Nairobi. Shayaan does not offer coaching at other clubs.</div></div><div class="card"><p class="meta">Your session</p><h3>Understand → Build → Compete</h3><p>Diagnose what is happening, develop a repeatable response, then apply it under point and match pressure.</p><Button href={site.bookingUrl} variant="dark" external event="book_coaching_click">Start Coaching</Button></div></div></section><section class="section section--sand"><div class="container"><h2>Frequently asked questions</h2><FAQ items={faq}/></div></section></Layout>

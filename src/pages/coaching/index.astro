---
import Layout from '../../layouts/Layout.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import CoachingCard from '../../components/CoachingCard.astro'; import Button from '../../components/Button.astro'; import { coachingPrograms, site } from '../../data/site';
---
<Layout title="Padel Coaching Nairobi | Private & Group Lessons" description="Explore private, beginner, partner, group and match padel coaching with Shayaan, exclusively at Ace Padel in Nairobi."><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Coaching</div><p class="eyebrow eyebrow--light">Padel lessons in Nairobi</p><h1>Coaching that makes your next point clearer.</h1><p class="lead">Train technique, movement, positioning and tactics with Shayaan—exclusively at Ace Padel, Aga Khan Sports Centre.</p><div class="button-row"><Button href={site.bookingUrl} variant="lime" external event="book_coaching_click">Book Coaching</Button></div></div></section><section class="section"><div class="container"><SectionHeading eyebrow="Choose your session" title="Built for your level and goals." text="Complete beginner, developing, intermediate or competitive: each session starts with what your game needs."/><div class="card-grid">{coachingPrograms.map((p,i)=><CoachingCard program={p} index={i}/>)}</div></div></section><section class="section section--forest"><div class="container"><SectionHeading eyebrow="How we improve" title="Technique with tactical purpose." text="Work on movement, shot selection, match awareness, partnership and confidence—not isolated shots with no match context." light/><div class="philosophy"><article><h3>Understand</h3><p>See the court and recognise the right decision.</p></article><article><h3>Build</h3><p>Make technique and movement more repeatable.</p></article><article><h3>Compete</h3><p>Use those skills in realistic match situations.</p></article></div></div></section></Layout>

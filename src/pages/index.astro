---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CoachingCard from '../components/CoachingCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { coachingPrograms, playerJourneys, site } from '../data/site';
const whatsapp = site.whatsappUrl("Hi Shayaan, I found your website and I'm interested in padel coaching at Ace Padel.");
const schema = { '@context':'https://schema.org', '@graph': [
  { '@type':'Person', '@id':'https://padelsiteshayaan.netlify.app/#shayaan', name:'Shayaan', jobTitle:'Padel Coach', address:{'@type':'PostalAddress',addressLocality:'Nairobi',addressCountry:'KE'}, knowsAbout:['Padel coaching','Padel tactics','Padel technique'], sameAs:[site.bookingUrl] },
  { '@type':'Service', name:'Padel coaching in Nairobi', provider:{'@id':'https://padelsiteshayaan.netlify.app/#shayaan'}, areaServed:{'@type':'City',name:'Nairobi'}, availableChannel:{'@type':'ServiceChannel',serviceLocation:{'@type':'Place',name:'Ace Padel, Aga Khan Sports Centre'}} }
]};
---
<Layout title="Padel Coaching Nairobi | Shayaan at Ace Padel" description="Improve your padel with private, partner, group and match coaching from Shayaan, exclusively at Ace Padel, Aga Khan Sports Centre in Nairobi, Kenya.">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<section class="hero"><div class="hero-image" role="img" aria-label="Illustrated glass-walled padel court placeholder for future Ace Padel photography"></div><div class="container hero-content"><p class="eyebrow eyebrow--light">Padel coaching in Nairobi</p><h1>Improve your padel.<br/><span>Win more points.</span></h1><h2>Play smarter. Move with purpose.</h2><p class="lead">Private coaching, partner sessions, group training and match coaching with Shayaan—exclusively at Ace Padel, Aga Khan Sports Centre.</p><div class="hero-actions"><Button href={site.bookingUrl} variant="lime" external event="book_coaching_click">Book Coaching</Button><Button href={whatsapp} variant="outline" external event="whatsapp_click">WhatsApp Shayaan</Button></div></div><div class="hero-location"><strong>Official coaching location</strong><br/>Ace Padel · Aga Khan Sports Centre<br/>Nairobi, Kenya</div></section>
<section class="trust-strip" aria-label="Coaching information"><ul class="container trust-list"><li>Nairobi, Kenya</li><li>Exclusively at Ace Padel</li><li>Beginner to Competitive</li><li>Private & Group Coaching</li><li>Playtomic Friendly</li></ul></section>
<section class="section section--sand"><div class="container"><SectionHeading eyebrow="Find your level" title="Where are you in your padel journey?" text="No official rating ranges or labels—just a useful starting point for choosing the training that fits your game."/><div class="card-grid">{playerJourneys.map((journey,index)=><article class="card"><span class="number">0{index+1}</span><h3>{journey.title}</h3><p>{journey.text}</p><a href={journey.href}>{journey.cta} →</a></article>)}</div></div></section>
<section class="section" id="coaching"><div class="container"><SectionHeading eyebrow="Coaching at Ace Padel" title="A session for the way you want to improve." text="Every program is delivered by Shayaan exclusively at Ace Padel, Aga Khan Sports Centre, Nairobi."/><div class="card-grid">{coachingPrograms.map((program,index)=><CoachingCard program={program} index={index}/>)}</div><div class="button-row"><Button href="/coaching" variant="dark">Explore All Coaching</Button><Button href={site.bookingUrl} variant="outline" external event="book_coaching_click">Book Coaching</Button></div></div></section>
<section class="section section--forest"><div class="container"><SectionHeading eyebrow="The Shayaan approach" title="Understand → Build → Compete" text="Better padel starts with knowing why—then creating repeatable skills that hold up in a match." light/><div class="philosophy"><article><h3>Understand</h3><p>Learn why things happen on court through positioning, decision making and tactical awareness.</p></article><article><h3>Build</h3><p>Develop repeatable technique, confident movement and better patterns with your partner.</p></article><article><h3>Compete</h3><p>Apply what you learn under match pressure and make clearer decisions when every point matters.</p></article></div></div></section>
<section class="section section--sand"><div class="container venue-feature"><div class="venue-media" role="img" aria-label="Ace Padel venue photography placeholder showing a glass padel court"></div><div class="venue-copy"><span class="location-chip">Exclusive coaching location</span><p class="eyebrow eyebrow--light">Coaching partner, not owned by Shayaan</p><h2>Train with me at Ace Padel.</h2><p><strong>Ace Padel — Aga Khan Sports Centre, Nairobi</strong></p><p>All Shayaan coaching takes place here. Looking for coaching? Train with Shayaan at Ace Padel. Looking for somewhere to play? Browse the independent Kenya court directory.</p><div class="button-row"><Button href="/ace-padel" variant="lime">Train at Ace Padel</Button><Button href={site.playtomicUrl} variant="outline" external event="playtomic_click">Book a Court</Button></div></div></div></section>
<section class="section"><div class="container"><SectionHeading eyebrow="Player stories" title="Progress, told by players." text="Real testimonials will appear here after Shayaan supplies and approves them. Nothing below is presented as a review."/><div class="card-grid">{[1,2,3].map(n=><TestimonialCard slotNumber={n}/>)}</div></div></section>
<section class="section section--sand"><div class="container"><SectionHeading eyebrow="Coaching videos" title="Improve your game with Shayaan." text="Short padel-specific lessons and Instagram Reels will be embedded here when original coaching footage is available."/><div class="card-grid">{['Beginner positioning','Defending with the glass','When to take the net','Building a reliable bandeja'].map(topic=><article class="card video-card"><div class="video-frame"><div><span class="play-icon">▶</span><span class="placeholder-label">Video coming soon</span></div></div><div class="card-content"><h3>{topic}</h3><p>Original Ace Padel coaching video slot.</p></div></article>)}</div></div></section>
<section class="section"><div class="container resource-banner"><div><p class="eyebrow">Padel Kenya resource</p><h2>Find courts. Learn the game. Play in Nairobi.</h2><p class="lead">Explore verified places to play across Kenya, understand Playtomic and build your padel knowledge. Court listings are informational and do not imply that Shayaan coaches there.</p></div><div class="resource-links"><a href="/padel-courts">Explore Padel Courts <span>→</span></a><a href="/playtomic-kenya">Playtomic Kenya Guide <span>→</span></a><a href="/find-padel-game-nairobi">Find a Game in Nairobi <span>→</span></a><a href="/learn">Learn Padel <span>→</span></a></div></div></section>
<section class="accent-cta"><p class="eyebrow">Your next point starts here</p><h2>Ready to improve your padel in Nairobi?</h2><p>Book coaching with Shayaan at Ace Padel, Aga Khan Sports Centre.</p><div class="button-row" style="justify-content:center"><Button href={site.bookingUrl} variant="dark" external event="book_coaching_click">Book Coaching</Button><Button href={whatsapp} variant="outline" external event="whatsapp_click">Message Shayaan</Button></div></section>
</Layout>

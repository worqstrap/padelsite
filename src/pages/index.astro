---
import Layout from '../layouts/PageLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CoachingCard from '../components/CoachingCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import VideoCard from '../components/VideoCard.astro';
import CourtCard from '../components/CourtCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/siteContent';
import { coachingPrograms, playerLevels, philosophySteps, testimonials, coachingVideos } from '../data/coaching';
import { padelCourts } from '../data/padelCourts';

const heroImage = 'https://images.pexels.com/photos/38031043/pexels-photo-38031043.jpeg?auto=compress&cs=tinysrgb&w=2200&h=1400&fit=crop';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: 'Shayaan Padel Coaching',
  description: 'Professional padel coaching in Nairobi, Kenya. Private, group and match-play coaching at Ace Padel, Aga Khan Sports Centre.',
  areaServed: { '@type': 'Country', name: 'Kenya' },
  founder: { '@type': 'Person', name: 'Shayaan', jobTitle: 'Padel Coach' },
  sport: 'Padel',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Nairobi',
    addressCountry: 'Kenya',
  },
  sameAs: [site.playtomicUrl, site.instagram],
};

const trustItems = [
  'Nairobi, Kenya',
  'Coaching at Ace Padel',
  'Beginners to Competitive',
  'Private & Group Coaching',
  'Playtomic Friendly',
];

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
  .slice(0, 3);
---

<Layout
  title="Padel Coaching in Nairobi | Shayaan Padel"
  description="Improve your padel with professional private, group and match-play coaching in Nairobi. Train with Shayaan at Ace Padel, Aga Khan Sports Centre. Book your session today."
  jsonLd={jsonLd}
>
  <Navbar />

  <main id="top">
    <!-- Section 1: Hero -->
    <section class="hero" id="hero">
      <div class="hero-media" style={`background-image:url('${heroImage}')`} role="img" aria-label="Padel players in action on an indoor court with glass walls"></div>
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow light"><span></span> Padel Coaching in Nairobi</p>
        <h1>Improve Your Padel.<br/><em>Play Smarter. Win More Points.</em></h1>
        <p class="hero-copy">Private coaching, group sessions and match training with Shayaan at Ace Padel, Aga Khan Sports Centre.</p>
        <div class="hero-actions">
          <a class="btn btn-lime" href={site.playtomicUrl} target="_blank" rel="noopener noreferrer" data-track="book-coaching">
            Book Coaching <span aria-hidden="true">↗</span>
          </a>
          <a class="btn btn-light btn-sm" href={site.instagram} target="_blank" rel="noopener noreferrer" data-track="instagram-click">Message on Instagram <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={site.playtomicUrl} target="_blank" rel="noopener noreferrer" data-track="playtomic-click">Book a Court <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-scroll"><span></span> Scroll to discover</div>
    </section>

    <!-- Section 2: Trust Strip -->
    <section class="trust-strip" aria-label="Key information">
      {trustItems.map((item) => <div class="trust-item">{item}</div>)}
    </section>

    <!-- Section 3: Find Your Level -->
    <section class="section-pad" id="levels">
      <SectionHeading eyebrow="Find your level" heading="Where are you in your" em="padel journey?" center={true} />
      <div class="level-grid">
        {playerLevels.map((level) => (
          <article class="level-card">
            <span class="level-number">{level.number}</span>
            <h3>{level.title}</h3>
            <p>{level.description}</p>
            <a href={site.playtomicUrl} target="_blank" rel="noopener noreferrer" class="level-cta" data-track="level-cta">
              {level.cta} <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- Section 4: Coaching Programs -->
    <section class="section-pad section-tint" id="coaching">
      <SectionHeading eyebrow="Coaching programs" heading="Coaching built around" em="the way you play." />
      <p class="section-intro">Whether you're picking up a racket for the first time or pushing for the next level, every session has a clear purpose and a plan made for you.</p>
      <div class="programs-grid">
        {coachingPrograms.map((program, i) => (
          <CoachingCard program={program} index={i} />
        ))}
      </div>
    </section>

    <!-- Section 5: Coaching Philosophy -->
    <section class="section-pad" id="approach">
      <SectionHeading eyebrow="The Shayaan approach" heading="More than hitting" em="a better ball." center={true} />
      <div class="philosophy-timeline">
        {philosophySteps.map((step, i) => (
          <article class="philosophy-step">
            <div class="philosophy-marker">
              <span>{step.number}</span>
              {i < philosophySteps.length - 1 && <div class="philosophy-line"></div>}
            </div>
            <div class="philosophy-content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Section 6: Ace Padel -->
    <section class="section-pad ace-section" id="ace-padel">
      <div class="ace-content">
        <p class="eyebrow light"><span></span> Official Coaching Location</p>
        <h2>Train with me at<br/><em>Ace Padel.</em></h2>
        <p class="ace-address">Ace Padel — Aga Khan Sports Centre, Nairobi</p>
        <p class="ace-description">Ace Padel is my exclusive coaching partner. Every session I run takes place here — at the heart of Nairobi's growing padel community in Parklands.</p>
        <div class="ace-features">
          <div><strong>Location</strong><span>Aga Khan Sports Centre, Parklands, Nairobi</span></div>
          <div><strong>Booking</strong><span>Available on Playtomic</span></div>
          <div><strong>Coaching</strong><span>Private, group & match sessions</span></div>
        </div>
        <div class="ace-actions">
          <a class="btn btn-lime" href={site.playtomicUrl} target="_blank" rel="noopener noreferrer" data-track="ace-train">
            Train at Ace Padel <span aria-hidden="true">↗</span>
          </a>
          <a class="btn btn-light btn-sm" href={site.playtomicUrl} target="_blank" rel="noopener noreferrer" data-track="playtomic-click">
            Book Court on Playtomic <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="ace-visual">
        <div class="ace-image" style="background-image:url('https://images.pexels.com/photos/38155778/pexels-photo-38155778.jpeg?auto=compress&cs=tinysrgb&w=1200&h=900&fit=crop')" role="img" aria-label="Indoor padel courts at Ace Padel with blue surfaces and glass walls"></div>
        <a href={site.acePadelInstagram} target="_blank" rel="noopener noreferrer" class="ace-instagram" data-track="instagram-click">
          Follow Ace Padel on Instagram <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <!-- Section 7: Coaching promise -->
    <section class="section-pad section-tint" id="session-plan">
      <SectionHeading eyebrow="What to expect" heading="Every session has" em="a clear purpose." center={true} />
      <div class="testimonials-grid">
        {testimonials.map((t) => <TestimonialCard testimonial={t} />)}
      </div>
    </section>

    <!-- Section 8: Coaching guides -->
    <section class="section-pad" id="guides">
      <SectionHeading eyebrow="Quick coaching guides" heading="Smarter habits for" em="your next match." center={true} />
      <p class="section-intro section-intro-center">Practical cues for technique, positioning and match strategy. Use these ideas on court, then build them into your game during a coaching session.</p>
      <div class="videos-grid">
        {coachingVideos.map((v) => <VideoCard video={v} />)}
      </div>
    </section>

    <!-- Section 9: Journal -->
    <section class="section-pad home-blog" id="journal">
      <div class="home-blog-head">
        <SectionHeading eyebrow="The Padel Journal" heading="Read. Learn." em="Play better." />
        <a href="/blog/" class="home-blog-all">View all articles <span aria-hidden="true">→</span></a>
      </div>
      <div class="blog-grid">
        {latestPosts.map((post) => <BlogCard post={post} />)}
      </div>
    </section>

    <!-- Section 10: Coaching venue -->
    <section class="section-pad section-dark" id="venue">
      <SectionHeading eyebrow="Where we train" heading="Your Nairobi" em="coaching venue." light={true} center={true} />
      <p class="section-intro section-intro-center section-intro-light">Train at Ace Padel in Parklands, bookable through Playtomic and easy to find at Aga Khan Sports Centre.</p>
      <div class="courts-preview">
        {padelCourts.map((court) => <CourtCard court={court} />)}
      </div>
      <div class="courts-teaser-cta">
        <a class="btn btn-lime" href={site.playtomicUrl} target="_blank" rel="noopener noreferrer" data-track="playtomic-click">
          Book Ace Padel on Playtomic <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="section-pad cta-final">
      <p class="eyebrow light"><span></span> Your next point starts here</p>
      <h2>Ready to raise<br/><em>your game?</em></h2>
      <p>Book coaching with Shayaan at Ace Padel, Aga Khan Sports Centre, Nairobi.</p>
      <div class="cta-final-actions">
        <a class="btn btn-lime" href={site.playtomicUrl} target="_blank" rel="noopener noreferrer" data-track="book-coaching">
          Book Coaching <span aria-hidden="true">↗</span>
        </a>
        <a class="btn btn-light" href={site.instagram} target="_blank" rel="noopener noreferrer" data-track="instagram-click">Message on Instagram <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // Mobile nav toggle
    const toggle = document.getElementById('nav-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    const header = document.getElementById('site-header');

    toggle?.addEventListener('click', () => {
      const isOpen = mobileNav?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      if (mobileNav) mobileNav.setAttribute('aria-hidden', String(!isOpen));
    });

    // Close mobile nav on link click
    mobileNav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    });

    // Header scroll effect
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY > 60;
      header?.classList.toggle('scrolled', scrolled);
    }, { passive: true });

  </script>
</Layout>
